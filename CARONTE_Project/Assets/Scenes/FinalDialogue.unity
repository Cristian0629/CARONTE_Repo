    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: caronteSprite
      value: 
      objectReference: {fileID: 1394179856}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: caronteBoxRoot
      value: 
      objectReference: {fileID: 1716687348}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: thanksShowTime
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: thanksTextRoot
      value: 
      objectReference: {fileID: 561683810}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: fadeCanvasGroup
      value: 
      objectReference: {fileID: 745136442}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.size
      value: 20
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: protaDialogueText
      value: 
      objectReference: {fileID: 1299555940}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: thanksCanvasGroup
      value: 
      objectReference: {fileID: 561683812}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: caronteDialogueText
      value: 
      objectReference: {fileID: 1666327773}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: isFinalDialogueScene
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[0].text
      value: "So\u2026 you\u2019re back."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[1].text
      value: And you actually brought the fifteen obols.
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[2].text
      value: "Yeah\u2026 and they weren\u2019t easy to get."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[3].text
      value: "Some souls really didn\u2019t want to give them up."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[4].text
      value: "They never do.\nThat\u2019s why this job isn\u2019t as simple as it
        looks."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[5].text
      value: For centuries I have ferried the lost, the damned, the forgotten.
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[6].text
      value: You said the coins were more than just payment.
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[7].text
      value: That they carried something with them.
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[8].text
      value: "They do.\nEvery obol holds a bit of what someone couldn\u2019t leave
        behind."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[9].text
      value: "So\u2026 why did you need fifteen?"
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[10].text
      value: Why make me collect all of these?
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[11].text
      value: "Because one day, this won\u2019t be my boat anymore."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[12].text
      value: And the river needs to know who you are.
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[13].text
      value: These coins are like your introduction.
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[14].text
      value: Proof you can handle what comes with this job.
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[15].text
      value: "So\u2026 does that mean I did okay?\nOr did I mess something up?"
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[16].text
      value: 'You did fine.

        Better than most would on their first try.'
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[17].text
      value: "You\u2019re not ready yet.\nBut now you\u2019ve actually started."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[18].text
      value: "Then I\u2019ll keep going.\nI won\u2019t let you down."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[19].text
      value: "Good.\nBecause the souls won\u2019t stop coming."
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
      propertyPath: lines.Array.data[3].speaker
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4956426659848964339, guid: 4144d46c8ffb8c041922672cd61bdc8f, type: 3}
